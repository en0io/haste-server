{
	"name": "en0-Haste-Server",
	"version": "1.0.0",
	"description": "en0.sh Haste Server",
	"private": true,
	"main": "dist/backend/server.js",
	"type": "module",
	"scripts": {
		"start": "node .",
		"dev": "yarn build && conc -n \"frontend,backend\" -c \"bgBlue,bgGreen\" \"yarn build:frontend --watch --clearScreen=false\" \"yarn dev:backend\"",
		"dev:backend": "tsup --watch --silent --onSuccess 'sleep 2 && node .'",
		"build": "conc -c \"bgBlue,bgGreen\" \"yarn:build:*\"",
		"build:frontend": "vite build",
		"build:backend": "tsup",
		"clean": "rimraf dist data",
		"lint": "eslint src --fix --ext ts",
		"format": "prettier --write src"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1079.0",
		"@fastify/rate-limit": "^11.1.0",
		"@fastify/sensible": "^6.0.4",
		"@fastify/static": "^9.1.3",
		"@fastify/swagger": "^9.7.0",
		"@fastify/swagger-ui": "^6.0.0",
		"@fastify/type-provider-typebox": "^6.1.0",
		"@pnotify/core": "^5.2.0",
		"@sapphire/fetch": "^3.0.5",
		"@sinclair/typebox": "^0.34.49",
		"@skyra/env-utilities": "^2.0.1",
		"fastify": "^5.9.0",
		"highlight.js": "^11.11.1",
		"ioredis": "^5.11.1"
	},
	"devDependencies": {
		"@sapphire/eslint-config": "^5.0.6",
		"@sapphire/prettier-config": "^2.0.0",
		"@sapphire/ts-config": "^5.0.3",
		"@types/node": "^26.1.0",
		"@typescript-eslint/eslint-plugin": "^8.62.1",
		"@typescript-eslint/parser": "^8.62.1",
		"autoprefixer": "^10.5.2",
		"concurrently": "^10.0.3",
		"esbuild-plugin-version-injector": "^1.2.1",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"prettier": "^3.9.4",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vite": "^8.1.3"
	},
	"eslintConfig": {
		"extends": "@sapphire"
	},
	"packageManager": "yarn@4.12.0"
}
